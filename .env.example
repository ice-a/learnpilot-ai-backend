# ===============================
# 基础配置
# ===============================
NODE_ENV=development
PORT=3000

# ===============================
# 数据库配置
# ===============================
MONGODB_URI=mongodb://192.168.28.9:27017/edu-ai-tutor

# ===============================
# 安全配置
# ===============================
# 32字节(64字符)的十六进制密钥，用于加密API密钥
# 示例: 0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
MASTER_KEY=xxxx

# JWT密钥，用于用户认证(当前版本可选)
JWT_SECRET=5d85454331bd499b936c87bb18c714a0

# ===============================
# 日志配置
# ===============================
LOG_LEVEL=info

# ===============================
# AI提供商默认配置
# ===============================
# 默认AI服务提供商配置(用于系统初始化和默认值)
DEFAULT_AI_BASE_URL=https://api.openai.com/v1
DEFAULT_AI_MODEL_ID=gpt-3.5-turbo
DEFAULT_AI_TIMEOUT=30000

# ===============================
# AI提供商配置（用于系统初始化）
# ===============================
# 配置以下信息，系统启动时将自动创建对应的AI提供商
# 注意：这些密钥仅用于初始化，后续可通过管理界面修改

OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL_ID=

# ===============================
# 性能配置
# ===============================
# 知识点生成缓存时间(毫秒)
KNOWLEDGE_CACHE_TTL=3600000

# AI请求最大重试次数
AI_MAX_RETRIES=3

# 并发AI请求限制
AI_CONCURRENT_LIMIT=5

# ===============================
# 认证与邮件配置
# ===============================
APP_BASE_URL=http://localhost:5173

# SMTP 可留空；未配置时邮件会降级为日志输出
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
